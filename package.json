{
  "name": "jokebakery-sync",
  "version": "0.8.0",
  "description": "Two-way sync of your JokeBakery jokes, sprints, lists, crashes and gigs with your vault as Markdown. Requires a JokeBakery account.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run"
  },
  "keywords": [
    "obsidian",
    "jokebakery",
    "comedy",
    "sync"
  ],
  "author": "James Hooker",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "obsidian": "^1.13.1",
    "tslib": "^2.6.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "yaml": "^2.4.5"
  }
}
