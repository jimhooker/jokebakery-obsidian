{
  "name": "bakerwriter-sync",
  "version": "0.2.2",
  "description": "Two-way sync of BakerWriter sprints, jokes, lists and crashes with your Obsidian vault.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production"
  },
